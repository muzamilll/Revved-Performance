NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=447999200655

# Analytics (optional). Leave empty and the provider simply doesn't load.
# Both only load after the visitor accepts the matching cookie category.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Brevo (launch offer email sign-up). Server-side only — never prefix with NEXT_PUBLIC_.
BREVO_API_KEY=
BREVO_LIST_ID=

# Lead system (enquiry capture + private dashboard at /dashboard). Server-side only.
# Neon Postgres connection string (Vercel > Storage > Neon adds this automatically).
DATABASE_URL=
# Password to sign in to /dashboard, and a long random string used to sign the session.
DASHBOARD_PASSWORD=
DASHBOARD_SECRET=
# Minutes before a "new" enquiry is flagged as unanswered (default 30).
ALERT_MINUTES=30
# Optional: email the owner on every form enquiry (resend.com).
RESEND_API_KEY=
OWNER_EMAIL=
FROM_EMAIL=

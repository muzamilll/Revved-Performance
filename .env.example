NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=447999200655

# Analytics (optional). Leave empty and the provider simply doesn't load.
# Both only load after the visitor accepts the matching cookie category.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Brevo (launch offer email sign-up). Server-side only — never prefix with NEXT_PUBLIC_.
BREVO_API_KEY=
BREVO_LIST_ID=

# Search Console and Bing Webmaster Tools HTML-tag verification codes (content value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
